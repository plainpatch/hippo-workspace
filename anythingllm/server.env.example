# AnythingLLM application environment overrides can go here.
# Keep secrets out of git. Copy this file to anythingllm/server.env before starting.
DISABLE_TELEMETRY=true
LLM_PROVIDER='generic-openai'
GENERIC_OPEN_AI_BASE_PATH='https://your-openai-compatible-gateway/v1'
GENERIC_OPEN_AI_API_KEY='replace-with-gateway-key'
GENERIC_OPEN_AI_MODEL_PREF='deepseek-v3.2'
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT='32768'
GENERIC_OPEN_AI_MAX_TOKENS='4096'
EMBEDDING_ENGINE='ollama'
EMBEDDING_BASE_PATH='http://host.docker.internal:11434'
EMBEDDING_MODEL_PREF='bge-m3:latest'
OLLAMA_EMBEDDING_BATCH_SIZE='1'
