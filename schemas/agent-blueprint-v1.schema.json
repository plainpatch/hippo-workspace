{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hippo.local/schemas/agent-blueprint-v1.schema.json",
  "title": "Hippo Agent Blueprint v1",
  "description": "Canonical persisted and exchanged representation of a Hippo Agent blueprint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "type",
    "name",
    "description",
    "systemPrompt",
    "skills",
    "mcpServers",
    "runtimeId",
    "rag",
    "rootNodeId",
    "nodes",
    "edges",
    "executionPolicy",
    "metadata"
  ],
  "properties": {
    "$schema": {
      "const": "https://hippo.local/schemas/agent-blueprint-v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "readOnly": true
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "readOnly": true
    },
    "type": {
      "enum": ["single", "dag"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "systemPrompt": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/definitions/skill" }
    },
    "mcpServers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "runtimeId": {
      "type": "string",
      "minLength": 1
    },
    "rag": {
      "$ref": "#/definitions/rag"
    },
    "rootNodeId": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" }
    },
    "executionPolicy": {
      "$ref": "#/definitions/executionPolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "createdAt": {
      "type": "string",
      "readOnly": true
    },
    "updatedAt": {
      "type": "string",
      "readOnly": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "single" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "rootNodeId": { "type": "string", "const": "" },
          "nodes": { "type": "array", "maxItems": 0 },
          "edges": { "type": "array", "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "rootNodeId": { "type": "string", "const": "root" },
          "nodes": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "definitions": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "instructions": { "type": "string" }
      }
    },
    "rag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "topN"],
      "properties": {
        "enabled": { "type": "boolean" },
        "topN": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "description",
        "systemPrompt",
        "transitionInstruction",
        "runtimeApprovalPolicy",
        "resultApprovalPolicy",
        "rag",
        "skills",
        "mcpServers",
        "metadata"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "task" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "transitionInstruction": { "type": "string" },
        "runtimeApprovalPolicy": {
          "enum": ["inherit", "untrusted", "on-request", "never"]
        },
        "resultApprovalPolicy": {
          "enum": ["none", "auto", "manual"]
        },
        "runtimeId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string" },
        "rag": { "$ref": "#/definitions/rag" },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/definitions/skill" }
        },
        "mcpServers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "input": true,
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "metadata"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDecisions"],
      "properties": {
        "maxDecisions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
